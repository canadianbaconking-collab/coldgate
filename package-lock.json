{
  "name": "coldgate",
  "version": "0.6.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "coldgate",
      "version": "0.6.0",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22.18.0"
      }
    },
    "node_modules/@coldgate/authority": {
      "resolved": "packages/authority",
      "link": true
    },
    "node_modules/@coldgate/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@coldgate/diff": {
      "resolved": "packages/diff",
      "link": true
    },
    "node_modules/@coldgate/trace": {
      "resolved": "packages/trace",
      "link": true
    },
    "packages/authority": {
      "name": "@coldgate/authority",
      "version": "0.6.0",
      "engines": {
        "node": ">=22.18.0"
      }
    },
    "packages/cli": {
      "name": "@coldgate/cli",
      "version": "0.6.0",
      "bin": {
        "coldgate": "bin/coldgate.js"
      },
      "engines": {
        "node": ">=22.18.0"
      }
    },
    "packages/diff": {
      "name": "@coldgate/diff",
      "version": "0.6.0",
      "engines": {
        "node": ">=22.18.0"
      }
    },
    "packages/trace": {
      "name": "@coldgate/trace",
      "version": "0.6.0",
      "engines": {
        "node": ">=22.18.0"
      }
    }
  }
}
