{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/home/example/projects"],
      "env": { "TOKEN": "EXAMPLE_SECRET_DO_NOT_EXPORT" },
      "tools": [
        { "name": "read_file", "allowedPaths": ["/home/example/projects"] },
        { "name": "write_file", "requiresApproval": true, "allowedPaths": ["/home/example/projects"] },
        { "name": "delete_file", "requiresApproval": false }
      ]
    },
    "remote": { "url": "https://example.invalid/mcp" }
  }
}
